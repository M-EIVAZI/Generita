{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "Generita.Api"
    }
  },
  "ApplicationUrls": {
    "PublicBaseUrl": "http://localhost:7161",
    "ClientBaseUrl": "http://localhost:3000",
    "BookProcessorBaseUrl": "http://localhost:8000"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "HttpsRedirection": {
    "Enabled": false
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "EnableDetailedErrors": true,
    "EnableSensitiveDataLogging": false
  },
  "Cache": {
    "DefaultExpirationMinutes": 30,
    "InstanceName": "generita:"
  },
  "ZarinPal": {
    "MerchantId": "",
    "CallbackUrl": "http://localhost:7161/Transaction/VerifyPayment"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "GeneritaApi",
    "Audience": "GeneritaClient",
    "ExpiryMinutes": 120
  },
  "AllowedHosts": "*"
}
